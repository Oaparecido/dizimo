# ========================================
# Variáveis de ambiente para AWS EC2
# Copie este arquivo como .env no servidor
# ========================================

# --- Laravel ---
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://seudominio.com

# --- Banco de Dados (PostgreSQL - RDS recomendado) ---
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:senha@host-rds:5432/dizimo

# --- Sessão, Cache e Fila (usam o banco de dados) ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Log ---
LOG_LEVEL=warning

# --- Mail ---
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@seudominio.com

# --- AWS (se usar S3 para arquivos) ---
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
